import("../src/asg") as asg
import("../src/projection") as projection
import("../src/core") as core
import("std/list") as list
import("std/rec") as rec

let store = asg.sample_store()

let p1 = projection.build_projection(store)?
let p2 = projection.build_projection(store)?

let inv = projection.invariant_report(store, p1)

let a1 = core.assert_equal("projection invariant", inv.ok, true)

let a2 = core.assert_equal(
  "deterministic projection hash",
  p1.hash,
  p2.hash
)

let a3 = core.assert_equal(
  "deterministic projection text",
  p1.text,
  p2.text
)

let ids = asg.materialized_ids(store)

let missing = list.filter(ids, fn(id) {
  !rec.has(p1.nodeMap, id)
})

let a4 = core.assert_equal(
  "nodeMap totality",
  list.len(missing),
  0
)

let renamed = asg.rename_node(store, "fn_main", "main2")?

let pm = projection.project_mutation(
  store,
  renamed,
  p1,
  "fn_main",
  "ws",
  "main.fard",
  "frame_1",
  1
)?

let rebuilt = projection.build_projection(renamed)?

let a5 = core.assert_equal(
  "diff replaces entire prior text",
  pm.diff.end,
  core.text_len(p1.text)
)

let a6 = core.assert_equal(
  "projection mutation text matches rebuilt projection",
  pm.projection.text,
  rebuilt.text
)

let a7 = core.assert_equal(
  "projection mutation hash matches rebuilt projection",
  pm.projection.hash,
  rebuilt.hash
)

let a8 = core.assert_equal(
  "rename changed projection text",
  p1.text == pm.projection.text,
  false
)

let a9 = core.assert_equal(
  "rename changed projection hash",
  p1.hash == pm.projection.hash,
  false
)

core.ok(core.test_summary("projection", [a1, a2, a3, a4, a5, a6, a7, a8, a9]))
