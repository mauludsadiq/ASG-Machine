import("../src/harness") as harness
import("../src/core") as core
import("std/list") as list

let convergence20 = harness.convergence_check(20, 3)
let convergence40 = harness.convergence_check(40, 7)
let reducerFailures = harness.run_failure_suite()
let reducerEdges = harness.run_reducer_edge_suite()

let assertions = [
  core.assert_equal("convergence20 result ok", convergence20.t, "ok"),
  core.assert_equal("convergence20 semantic ok", convergence20.v.ok, true),
  core.assert_equal("convergence40 result ok", convergence40.t, "ok"),
  core.assert_equal("convergence40 semantic ok", convergence40.v.ok, true),
  core.assert_equal("reducer failures result ok", reducerFailures.t, "ok"),
  core.assert_equal("reducer edges result ok", reducerEdges.t, "ok")
]

let summary = core.test_summary("asg-machine-full-suite", assertions)

{
  overallOk: summary.ok,
  summary: summary,
  suites: {
    convergence20: convergence20,
    convergence40: convergence40,
    reducerFailures: reducerFailures,
    reducerEdges: reducerEdges
  }
}
