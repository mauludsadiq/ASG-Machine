import("std/net") as net
import("std/json") as json
import("std/mutex") as mutex
import("std/rec") as rec
import("./src/core") as core
import("./src/asg") as asg
import("./src/reducer") as reducer
import("./src/frame") as frm
import("./src/journal") as journal
import("./src/gateway") as gateway
import("./src/ordered_log") as olog
import("./src/reducer_consumer") as rc
import("./src/frame_bus") as fbus
import("./src/server") as srv
import("./src/server_process") as sp
import("./src/workspace_state") as ws_state

let DATA_DIR = "data/server"
let WS_ID = "ws"
let FILE_ID = "main.fard"

// Build runtime from saved snapshot + journal
fn build_runtime_from_saved(snap_data, jrnl) {
  let store = snap_data.store in
  let rr = reducer.init(WS_ID, FILE_ID, store) in
  if core.is_err(rr) then rr else
  let rr2 = { ...rr.v, globalVersion: snap_data.version } in
  let mach = frm.make_machine(rr2, 10, 0) in
  let g = gateway.empty_gateway(WS_ID) in
  let log = olog.empty_log(WS_ID) in
  let consumer = rc.make_consumer(WS_ID, "runtime", mach, jrnl) in
  let bus = { ...fbus.empty_bus(WS_ID), fileId: FILE_ID } in
  core.ok({ workspaceId: WS_ID, fileId: FILE_ID, gateway: g, log: log, consumer: consumer, bus: bus })
}

// Load existing state or create fresh
fn boot_server() {
  if !ws_state.has_saved_state(DATA_DIR, WS_ID) then
    let store = asg.sample_store() in
    srv.create_workspace(srv.empty_server("0.7.0"), WS_ID, FILE_ID, store) else
  let snap_r = ws_state.load_snapshot(DATA_DIR, WS_ID) in
  if core.is_err(snap_r) then
    let store = asg.sample_store() in
    srv.create_workspace(srv.empty_server("0.7.0"), WS_ID, FILE_ID, store) else
  let jrnl_r = ws_state.load_journal(DATA_DIR, WS_ID) in
  let jrnl = if core.is_err(jrnl_r) then journal.empty_journal(WS_ID, FILE_ID) else jrnl_r.v in
  let rt_r = build_runtime_from_saved(snap_r.v, jrnl) in
  if core.is_err(rt_r) then
    let store = asg.sample_store() in
    srv.create_workspace(srv.empty_server("0.7.0"), WS_ID, FILE_ID, store) else
  let s = srv.empty_server("0.7.0") in
  core.ok({ ...s, workspaces: rec.set(s.workspaces, WS_ID, rt_r.v) })
}

let boot = boot_server()
let initial_server = if core.is_err(boot) then srv.empty_server("0.7.0") else boot.v

let state = mutex.new(initial_server)

net.serve(7777, fn(req) {
  let current = mutex.lock(state) in
  let result = sp.handle(current, req) in
  let new_server = result.server in
  let _ = mutex.unlock(state, new_server) in
  let ws = rec.get(new_server.workspaces, WS_ID) in
  let _ = if ws != null && req.method == "POST" then
    ws_state.save_runtime(DATA_DIR, WS_ID, FILE_ID, ws)
  else null in
  result.response
})
