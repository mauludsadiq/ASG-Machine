import("std/list") as list
import("std/rec") as rec
import("std/str") as str
import("./core") as core

// Audit log: hash-chained entries for every server event.

fn make_audit_log() { { entries: [], headHash: "" } }

fn make_entry(eventType, data, prevHash) {
  let payload = { eventType: eventType, data: data, prevHash: prevHash } in
  let entryHash = core.digest(payload) in
  { eventType: eventType, data: data, prevHash: prevHash, entryHash: entryHash }
}

fn append(log, eventType, data) {
  let entry = make_entry(eventType, data, log.headHash) in
  { entries: list.concat([log.entries, [entry]]), headHash: entry.entryHash }
}

fn append_tx_accepted(log, userId, txId, workspaceId, ingressSeq) {
  append(log, "TX_ACCEPTED", { userId: userId, txId: txId, workspaceId: workspaceId, ingressSeq: ingressSeq })
}

fn append_tx_duplicate(log, userId, txId, workspaceId) {
  append(log, "TX_DUPLICATE", { userId: userId, txId: txId, workspaceId: workspaceId })
}

fn append_denied(log, userId, reason, path, workspaceId) {
  append(log, "REQUEST_DENIED", { userId: userId, reason: reason, path: path, workspaceId: workspaceId })
}

fn append_auth_failure(log, reason, path) {
  append(log, "AUTH_FAILURE", { reason: reason, path: path })
}

fn append_nonce_replay(log, userId, nonce) {
  append(log, "NONCE_REPLAY", { userId: userId, nonce: nonce })
}

fn append_read(log, userId, eventType, workspaceId) {
  append(log, eventType, { userId: userId, workspaceId: workspaceId })
}

fn entries_since(log, n) {
  list.filter(log.entries, fn(e) { list.find_index(log.entries, fn(x) { x.entryHash == e.entryHash }).some >= n })
}

fn since_index(log, idx) {
  list.drop(log.entries, idx)
}

fn verify_chain(log) {
  let n = list.len(log.entries) in
  if n == 0 then core.ok(true) else
  let chain_ok = list.all(list.range(1, n), fn(i) {
    let prev = list.get(log.entries, i - 1) in
    let curr = list.get(log.entries, i) in
    curr.prevHash == prev.entryHash
  }) in
  let head_ok = log.headHash == list.last(log.entries).entryHash in
  if !chain_ok then core.err("AUDIT_CHAIN_BROKEN", { entryCount: n }) else
  if !head_ok then core.err("AUDIT_HEAD_MISMATCH", {}) else
  core.ok(true)
}

fn audit_hash(log) { log.headHash }

export { make_audit_log, append, append_tx_accepted, append_tx_duplicate, append_denied, append_auth_failure, append_nonce_replay, append_read, since_index, verify_chain, audit_hash }
