import("src/asg") as asg
import("src/transactions") as txs
import("src/reducer") as reducer
import("src/frame") as frm
import("src/core") as core
import("std/list") as list
import("std/str") as str

// Adversarial scenario: concurrent structural edits
// User A: rename fn_main -> compute  (changes "main" at offset 3, len 4)
// User B: set stmt_1 value to "counter + 1"  (changes "1" at offset 19, len 1)
// Both computed against base: "fn main() {  let x = 1\n  return x\n}\n"

let store = asg.sample_store()
let rr = reducer.init("ws", "main.fard", store)?
let base = rr.projection.text
let mach = frm.make_machine(rr, 10, 0)

// === ASG MACHINE: both ops applied to node IDs ===
let tx_a = txs.tx("tx_a", "ws", [], [txs.pre_exists("fn_main")],
  txs.op_rename("fn_main", "compute"), 1, "replica_a")
let tx_b = txs.tx("tx_b", "ws", [], [txs.pre_exists("stmt_1")],
  txs.op_set("stmt_1", "value", "counter + 1"), 1, "replica_b")

let m_both = frm.run_batches(mach, [tx_a, tx_b])?
let asg_result = m_both.reducer.projection.text

// === TEXT CRDT: character-level patches against base ===
// Find "main" in base -> that's edit A's target
// Find "1" (the value) in base -> that's edit B's target

// Edit A: "main" starts at offset 3 in "fn main() {..."
let edit_a_start = 3
let edit_a_old = "main"
let edit_a_new = "compute"
let edit_a_delta = str.len(edit_a_new) - str.len(edit_a_old)

// Edit B: the value "1" is in "let x = 1" — find its position
// "fn main() {  let x = 1\n"
//  0123456789012345678901234
// "1" is at offset 21
let edit_b_start = 21
let edit_b_old = "1"
let edit_b_new = "counter + 1"

// Apply edit A to base
let after_a = str.concat([
  str.slice(base, 0, edit_a_start),
  edit_a_new,
  str.slice(base, edit_a_start + str.len(edit_a_old), str.len(base))
])

// TEXT CRDT naive: apply edit B at original offset (no transform)
// After edit A, edit B's offset is wrong if edit A was before edit B
let crdt_naive_start = edit_b_start
let crdt_naive = str.concat([
  str.slice(after_a, 0, crdt_naive_start),
  edit_b_new,
  str.slice(after_a, crdt_naive_start + str.len(edit_b_old), str.len(after_a))
])

// OT-corrected: transform edit B's offset by edit A's delta
let crdt_ot_start = edit_b_start + edit_a_delta
let crdt_ot = str.concat([
  str.slice(after_a, 0, crdt_ot_start),
  edit_b_new,
  str.slice(after_a, crdt_ot_start + str.len(edit_b_old), str.len(after_a))
])

// Validate
let asg_valid = str.contains(asg_result, "compute") && str.contains(asg_result, "counter + 1")
let crdt_naive_broken = crdt_naive != asg_result
let crdt_ot_matches = crdt_ot == asg_result

core.ok({
  base: base,
  edit_a: { what: "rename main->compute", offset: edit_a_start, delta: edit_a_delta },
  edit_b: { what: "set value to counter+1", offset: edit_b_start },
  asg_machine: asg_result,
  crdt_naive: crdt_naive,
  crdt_naive_broken: crdt_naive_broken,
  crdt_ot: crdt_ot,
  crdt_ot_matches_asg: crdt_ot_matches,
  asg_valid: asg_valid,
  verdict: if asg_valid && crdt_naive_broken then "ASG_WINS_NAIVE_CRDT_BROKEN" else if asg_valid && crdt_ot_matches then "OT_EQUIVALENT_BUT_REQUIRES_TRANSFORM" else "INCONCLUSIVE"
})
